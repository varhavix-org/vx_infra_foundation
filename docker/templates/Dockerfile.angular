# ============================================
# VarhaviX Generic Angular UI Dockerfile
# Multi-stage build: Node 22 + Nginx
# ============================================
# Usage: docker build -f Dockerfile.angular -t <image> <context>
# Override: Copy this into your app repo and customize as needed.

FROM node:22-alpine AS build
WORKDIR /app

# Cache dependencies
COPY package*.json ./
RUN npm ci --silent

# Build
COPY . .
RUN npm run build -- --configuration=production

# Runtime
FROM nginx:1.27-alpine

# Copy built assets — handles both ng build output structures
COPY --from=build /app/dist/*/browser /usr/share/nginx/html
COPY docker/nginx/nginx.base.conf /etc/nginx/conf.d/default.conf

RUN addgroup -S varhavix && adduser -S varhavix -G varhavix && \
    chown -R varhavix:varhavix /var/cache/nginx /var/log/nginx /etc/nginx/conf.d

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget --spider -q http://localhost:80/ || exit 1
